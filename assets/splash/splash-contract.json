{
  "version": 2,
  "description": "Single source of truth for the Levela splash (launch welcome) flow. scripts/verify_splash_parity.sh checks that the Android and iOS Splash features expose the same stages, timings, copy and colours. The splash icon is the app's own launcher icon foreground (no generated asset). Colour names refer to the primitive labels in THEME_COLORS.md.",
  "verifier": "scripts/verify_splash_parity.sh",
  "themeReference": "THEME_COLORS.md",

  "flow": {
    "stages": ["brand", "welcome", "actions"],
    "autoAdvanceMs": { "brand": 1200, "welcome": 1200 },
    "showEveryLaunch": true
  },

  "text": {
    "titleLine1": "Start your",
    "titleLine2": "Fitness Journey",
    "login": "Login",
    "register": "Register",
    "guest": "Continue as a guest"
  },

  "palette": {
    "Blue500": "#0078F0",
    "Blue700": "#0058D0",
    "LightBlue100": "#E6F6FE",
    "LightBlue300": "#A0E0F8",
    "Gray100": "#EEF2F7",
    "Gray500": "#64748B",
    "Navy900": "#0B1220"
  },

  "colors": {
    "backgroundGradient": ["White", "LightBlue100"],
    "backgroundGlow": "LightBlue300",
    "title": "Navy900",
    "loginBackground": "Gray100",
    "loginText": "Blue700",
    "registerBackground": "Blue500",
    "registerText": "White",
    "guestText": "Gray500"
  },

  "icon": {
    "sizeDp": 96,
    "note": "The app's own launcher icon foreground: Android @drawable/ic_launcher_foreground, iOS AppIcon (dark/alpha appearance). Not generated."
  },

  "targets": {
    "android": {
      "module": ":splash",
      "namespace": "com.yuzutaru.splash",
      "tokensFile": "android/splash/src/main/java/com/yuzutaru/splash/SplashTokens.kt",
      "designColorFile": "android/design/src/main/java/com/yuzutaru/design/ui/theme/Color.kt"
    },
    "ios": {
      "package": "Splash",
      "tokensFile": "ios/Packages/Splash/Sources/Splash/SplashTokens.swift",
      "designColorFile": "ios/Packages/Design/Sources/Design/Color.swift"
    }
  }
}
