{
  "version": 2,
  "description": "Single source of truth for the Levela post-guest onboarding flow (welcome, goal, profile, weight, height). scripts/verify_onboarding_parity.sh checks that the Android and iOS Onboarding features expose the same steps, copy, units, defaults, value ranges, goals, sex options, colours and welcome illustration. Colour names refer to the primitive labels in THEME_COLORS.md.",
  "verifier": "scripts/verify_onboarding_parity.sh",
  "themeReference": "THEME_COLORS.md",

  "flow": {
    "steps": ["welcome", "goal", "profile", "weight", "height"]
  },

  "text": {
    "welcomeTitle": "Start your Fitness Journey",
    "welcomeSubtitle": "Start your fitness journey with our app's guidance and support",
    "goalTitle": "What is your goal?",
    "profileTitle": "Tell us about you",
    "ageTitle": "Age",
    "sexTitle": "Biological sex",
    "weightTitle": "What is your weight?",
    "heightTitle": "What is your height?",
    "start": "Let's start",
    "next": "Next",
    "back": "Back"
  },

  "goals": [
    { "title": "Lose fat", "subtitle": "Burn fat and reveal a leaner physique" },
    { "title": "Maintain weight", "subtitle": "Keep your current weight and stay consistent" },
    { "title": "Gain muscle", "subtitle": "Build strength and add lean muscle" },
    { "title": "Improve health", "subtitle": "Feel better and boost daily energy" },
    { "title": "Improve performance", "subtitle": "Get stronger, faster and more athletic" },
    { "title": "Fast consistently", "subtitle": "Stick to a regular fasting routine" },
    { "title": "Train for an event", "subtitle": "Prepare for a race or competition" }
  ],

  "sex": ["Female", "Male", "Prefer not to say"],

  "units": {
    "weight": ["lb", "kg"],
    "height": ["ft/in", "cm"],
    "age": ["years"]
  },

  "defaults": {
    "weightUnit": "kg",
    "heightUnit": "cm"
  },

  "values": {
    "weight": {
      "kg": { "min": 30, "max": 160, "step": 1, "default": 70 },
      "lb": { "min": 66, "max": 352, "step": 1, "default": 154 }
    },
    "height": {
      "cm": { "min": 120, "max": 220, "step": 1, "default": 170 },
      "ft/in": { "min": 47, "max": 87, "step": 1, "default": 67 }
    },
    "age": {
      "years": { "min": 13, "max": 100, "step": 1, "default": 30 }
    }
  },

  "palette": {
    "Navy900": "#0B1220",
    "Gray100": "#EEF2F7",
    "Gray200": "#E2E8F0",
    "Gray300": "#CBD5E1",
    "Gray500": "#64748B",
    "Blue100": "#D6E9FF",
    "Blue300": "#7FB6FF",
    "Blue500": "#0078F0",
    "LightBlue100": "#E6F6FE",
    "LightBlue300": "#A0E0F8"
  },

  "colors": {
    "background": "White",
    "title": "Navy900",
    "subtitle": "Gray500",
    "value": "Navy900",
    "activeSegment": "Blue500",
    "inactiveSegment": "Gray200",
    "rulerTick": "Gray300",
    "rulerLabel": "Gray500",
    "rulerAccent": "Blue500",
    "cardWeight": "LightBlue100",
    "cardWeightAccent": "LightBlue300",
    "cardHeight": "Blue100",
    "cardHeightAccent": "Blue300",
    "nextBackground": "Blue500",
    "nextText": "White",
    "nextDisabledBackground": "Gray200",
    "nextDisabledText": "Gray500",
    "goalCardActive": "Blue100",
    "goalCardActiveBorder": "Blue500",
    "goalCardInactive": "White",
    "goalCardInactiveBorder": "Gray200",
    "goalDotActive": "Blue500",
    "goalDotInactive": "Gray300",
    "toggleTrack": "Gray100",
    "toggleSelectedBackground": "Blue500",
    "toggleSelectedText": "White",
    "toggleUnselectedText": "Gray500"
  },

  "illustration": {
    "source": "assets/onboarding/welcome-illustration.png",
    "masterSize": 1280,
    "cornerRadiusDp": 28,
    "cornerRadiusToken": "welcomeIllustrationCorner",
    "note": "Hero illustration on the welcome step, between the subtitle and the primary button. Rounded corners match the value cards. Android ships density buckets that fill the available width (24dp horizontal padding); iOS ships 1x/2x/3x.",
    "android": {
      "drawable": "welcome_illustration",
      "densities": { "mdpi": 312, "hdpi": 468, "xhdpi": 624, "xxhdpi": 936, "xxxhdpi": 1248 }
    },
    "ios": {
      "imageset": "WelcomeIllustration",
      "scales": { "1x": 312, "2x": 624, "3x": 936 }
    }
  },

  "targets": {
    "android": {
      "module": ":onboarding",
      "namespace": "com.yuzutaru.onboarding",
      "tokensFile": "android/onboarding/src/main/java/com/yuzutaru/onboarding/OnboardingTokens.kt",
      "designColorFile": "android/design/src/main/java/com/yuzutaru/design/ui/theme/Color.kt"
    },
    "ios": {
      "package": "Onboarding",
      "tokensFile": "ios/Packages/Onboarding/Sources/Onboarding/OnboardingTokens.swift",
      "designColorFile": "ios/Packages/Design/Sources/Design/Color.swift"
    }
  }
}
