{
  "version": 1,
  "description": "Single source of truth for the Levela app icon. scripts/generate_icons.sh reads this file and regenerates every Android and iOS icon asset from source.png, so the two platforms can never drift apart. To change the icon: replace source.png (or tweak a value below) and run scripts/generate_icons.sh.",
  "source": "assets/app-icon/source.png",
  "generator": "scripts/generate_icons.sh",
  "background": {
    "light": "#FFFFFF",
    "dark": "#1C1C1E",
    "tinted": "#000000"
  },
  "android": {
    "adaptive": {
      "canvasDp": 108,
      "safeZoneDp": 66
    },
    "densities": {
      "mdpi": { "scale": 1.0, "foreground": 108, "legacy": 48 },
      "hdpi": { "scale": 1.5, "foreground": 162, "legacy": 72 },
      "xhdpi": { "scale": 2.0, "foreground": 216, "legacy": 96 },
      "xxhdpi": { "scale": 3.0, "foreground": 324, "legacy": 144 },
      "xxxhdpi": { "scale": 4.0, "foreground": 432, "legacy": 192 }
    }
  },
  "ios": {
    "size": 1024,
    "appiconset": "ios/Levela/Assets.xcassets/AppIcon.appiconset"
  },
  "targets": {
    "ios": [
      { "file": "AppIcon-1024.png", "appearance": "light", "size": 1024, "opaque": true },
      { "file": "AppIcon-1024-dark.png", "appearance": "dark", "size": 1024, "opaque": false },
      { "file": "AppIcon-1024-tinted.png", "appearance": "tinted", "size": 1024, "opaque": true }
    ],
    "android": [
      { "kind": "foreground", "pathTemplate": "android/app/src/main/res/drawable-{density}/ic_launcher_foreground.png", "sizeFrom": "foreground", "opaque": false },
      { "kind": "monochrome", "pathTemplate": "android/app/src/main/res/drawable-{density}/ic_launcher_monochrome.png", "sizeFrom": "foreground", "opaque": false },
      { "kind": "legacy", "pathTemplate": "android/app/src/main/res/mipmap-{density}/ic_launcher.png", "sizeFrom": "legacy", "opaque": true },
      { "kind": "legacy-round", "pathTemplate": "android/app/src/main/res/mipmap-{density}/ic_launcher_round.png", "sizeFrom": "legacy", "opaque": false }
    ]
  }
}
